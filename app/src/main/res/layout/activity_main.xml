<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="56dp">

        <!-- Islamic Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_dark_surface"
            android:paddingHorizontal="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="16dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_quran_logo"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
                        android:textSize="12sp"
                        android:textColor="@color/gold_light" />
                </LinearLayout>

                <!-- Audio Wave / Status Badge -->
                <TextView
                    android:id="@+id/tv_playback_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_islamic"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Ready"
                    android:textSize="11sp"
                    android:textColor="@color/emerald_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 1. HOME VIEW -->
                <LinearLayout
                    android:id="@+id/view_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="visible">

                    <!-- Master Quran Unlock Switch Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/bg_dark_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_master_status_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Unlock Recitation"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_master_status_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Plays next verse whenever phone is unlocked"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_unlock_enabled"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Current Verse Display Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/bg_dark_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="CURRENT VERSE"
                                    android:textSize="11sp"
                                    android:letterSpacing="0.1"
                                    android:textColor="@color/emerald_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_current_ayah_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_card_islamic"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="3dp"
                                    android:text="Ayah 1"
                                    android:textColor="@color/gold_accent"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Arabic Surah Name -->
                            <TextView
                                android:id="@+id/tv_surah_arabic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الفاتحة"
                                android:textSize="32sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="8dp"
                                android:layout_gravity="center_horizontal" />

                            <!-- Surah English & Urdu Title -->
                            <TextView
                                android:id="@+id/tv_surah_english_urdu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Surah Al-Fatihah — الفاتحہ (آغاز)"
                                android:textSize="15sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="4dp"
                                android:layout_gravity="center_horizontal" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/border_dark"
                                android:layout_marginVertical="16dp" />

                            <!-- Quran Sequence Progress -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tv_progress_ayah_count"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="1 / 6236 Ayahs"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_progress_percentage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.02%"
                                    android:textColor="@color/emerald_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/pb_quran_progress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="8dp"
                                android:max="6236"
                                android:progress="1"
                                android:progressTint="@color/emerald_primary" />

                            <!-- Next Verse Badge -->
                            <TextView
                                android:id="@+id/tv_next_verse_preview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Next Unlock: Surah Al-Fatihah, Ayah 2"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Testing and Control Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_test_audio"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="@string/btn_test_audio"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_play"
                            app:backgroundTint="@color/emerald_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stop_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/btn_stop_audio"
                            android:textSize="14sp"
                            android:visibility="gone"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_stop"
                            app:backgroundTint="@color/red_accent" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. PROGRESS / JUMP VIEW -->
                <LinearLayout
                    android:id="@+id/view_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sequential Quran Progress"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The app strictly reads verse by verse from Surah 1 to Surah 114 without skipping."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />

                    <!-- Quick Jump Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/bg_dark_surface"
                        app:cardCornerRadius="16dp"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jump to Specific Surah &amp; Ayah"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="15sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical">

                                <EditText
                                    android:id="@+id/et_jump_surah"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:hint="Surah (1-114)"
                                    android:inputType="number"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_muted"
                                    android:background="@drawable/bg_card_islamic"
                                    android:paddingHorizontal="12dp" />

                                <EditText
                                    android:id="@+id/et_jump_ayah"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:hint="Ayah"
                                    android:inputType="number"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_muted"
                                    android:background="@drawable/bg_card_islamic"
                                    android:paddingHorizontal="12dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_jump_apply"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:layout_marginStart="8dp"
                                    android:text="Jump"
                                    app:cornerRadius="10dp"
                                    app:backgroundTint="@color/emerald_primary" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Reset Progress Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/bg_dark_surface"
                        app:cardCornerRadius="16dp"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reset Quran Progress"
                                android:textColor="@color/red_accent"
                                android:textStyle="bold"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Restart recitation from Surah Al-Fatihah, Ayah 1."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_reset_progress"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginTop="12dp"
                                android:text="@string/btn_reset_progress"
                                app:cornerRadius="10dp"
                                app:backgroundTint="@color/red_accent" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- 3. SETTINGS VIEW -->
                <LinearLayout
                    android:id="@+id/view_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recitation Settings"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <!-- Arabic Audio Toggle -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/bg_dark_surface"
                        app:cardCornerRadius="16dp"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Arabic Recitation"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Reciter: Mishary Rashid Alafasy"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_arabic_audio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Urdu Audio Toggle -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/bg_dark_surface"
                        app:cardCornerRadius="16dp"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Urdu Translation Audio"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Voice: Shamshad Ali Khan (Jalandhari translation)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_urdu_audio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Battery & Background Guide -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/bg_dark_surface"
                        app:cardCornerRadius="16dp"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/battery_guide_title"
                                android:textColor="@color/gold_accent"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/battery_guide_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_battery_optimization"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginTop="12dp"
                                android:text="@string/btn_battery_settings"
                                app:cornerRadius="10dp"
                                app:backgroundTint="@color/emerald_dark" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- 4. ABOUT VIEW -->
                <LinearLayout
                    android:id="@+id/view_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About Quran Unlock"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/bg_dark_surface"
                        app:cardCornerRadius="16dp"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Native Android Application"
                                android:textColor="@color/emerald_primary"
                                android:textStyle="bold"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quran Unlock is a native Kotlin Android application that plays one Quran verse with its Urdu translation every time you unlock your phone. It runs completely offline after audio caching, requires zero user accounts, collects zero analytics, and contains no advertisements."
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:layout_marginTop="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Version 1.0.0 • Sadaqah Jariyah"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </FrameLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@color/bg_dark_surface"
        app:itemIconTint="@color/emerald_primary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
